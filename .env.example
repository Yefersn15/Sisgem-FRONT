# URL base de la API. Si se deja vacía, src/services/api/client.js usa
# http://localhost:3000 en desarrollo y https://sisgem-api.onrender.com en
# producción como valores por defecto.
VITE_API_BASE_URL=http://localhost:3000

# Variable heredada: actualmente no tiene efecto en el comportamiento de la
# app (todas las peticiones se hacen siempre contra la API vía client.js).
VITE_USE_REMOTE_API=false
